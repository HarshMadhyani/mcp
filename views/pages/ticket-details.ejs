<div class="breadcrumb">
  <a href="/admin/tickets">Tickets</a>
  <i data-lucide="chevron-right"></i>
  <span><%= ticket.ticket_id %></span>
</div>

<div class="page-header-content flex-between">
  <div>
    <h1 class="page-title"><%= ticket.ticket_id %></h1>
    <p class="page-subtitle">Submitted on <%= new Date(ticket.created_at).toLocaleString() %></p>
  </div>
  <div>
    <span class="badge <%= ticket.status === 'OPEN' ? 'badge-primary' : 'badge-outline' %>"><%= ticket.status %></span>
  </div>
</div>

<div class="dashboard-grid">
  <!-- Ticket Details -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Ticket Information</h2>
    </div>
    <div class="card-body">
      <dl class="details-list">
        <div class="detail-item">
          <dt>Student Name</dt>
          <dd><a href="/admin/students/<%= ticket.student_id %>" class="link"><%= ticket.student_name || 'N/A' %></a></dd>
        </div>
        <div class="detail-item">
          <dt>WhatsApp Number</dt>
          <dd><%= ticket.whatsapp_number %></dd>
        </div>
        <div class="detail-item">
          <dt>Interested Course</dt>
          <dd><%= ticket.course || '-' %></dd>
        </div>
        <div class="detail-item">
          <dt>Question / Issue</dt>
          <dd class="mt-2 p-4 bg-secondary rounded border"><%= ticket.question %></dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- Update Status & Notes -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Manage Ticket</h2>
    </div>
    <div class="card-body">
      <form action="/admin/tickets/<%= ticket.ticket_id %>" method="POST">
        <div class="form-group">
          <label class="form-label">Status</label>
          <select name="status" class="select w-full">
            <option value="OPEN" <%= ticket.status === 'OPEN' ? 'selected' : '' %>>Open</option>
            <option value="IN_PROGRESS" <%= ticket.status === 'IN_PROGRESS' ? 'selected' : '' %>>In Progress</option>
            <option value="RESOLVED" <%= ticket.status === 'RESOLVED' ? 'selected' : '' %>>Resolved</option>
            <option value="CLOSED" <%= ticket.status === 'CLOSED' ? 'selected' : '' %>>Closed</option>
          </select>
        </div>
        
        <div class="form-group">
          <label class="form-label">Assign To</label>
          <select name="assigned_admin" class="select w-full">
            <option value="">Unassigned</option>
            <% admins.forEach(a => { %>
              <option value="<%= a.admin_id %>" <%= ticket.assigned_admin === a.admin_id ? 'selected' : '' %>>
                <%= a.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Internal Notes</label>
          <textarea name="admin_notes" class="textarea w-full" rows="5" placeholder="Add internal notes..."><%= ticket.admin_notes %></textarea>
        </div>

        <div class="flex-end">
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>
