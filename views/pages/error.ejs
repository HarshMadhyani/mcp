<div class="card mx-auto mt-10" style="max-width: 500px; text-align: center;">
  <div class="card-body py-10">
    <div class="mb-6 text-muted">
      <% if (statusCode === 404) { %>
        <i data-lucide="file-question" style="width: 64px; height: 64px; margin: 0 auto;"></i>
      <% } else if (statusCode === 403) { %>
        <i data-lucide="lock" style="width: 64px; height: 64px; margin: 0 auto;"></i>
      <% } else { %>
        <i data-lucide="alert-triangle" style="width: 64px; height: 64px; margin: 0 auto; color: var(--error);"></i>
      <% } %>
    </div>
    <h1 class="page-title"><%= title || 'Error' %></h1>
    <p class="text-lg text-muted mb-8"><%= message || 'Something went wrong.' %></p>
    <a href="/admin/dashboard" class="btn btn-primary">Return to Dashboard</a>
  </div>
</div>
