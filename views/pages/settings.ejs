<div class="page-header-content">
  <h1 class="page-title">Settings</h1>
  <p class="page-subtitle">Configure bot and university settings</p>
</div>

<div class="dashboard-grid">
  <!-- WhatsApp Connection Status -->
  <div class="card">
    <div class="card-header border-b">
      <h2 class="card-title flex items-center gap-2">
        <i data-lucide="smartphone"></i> WhatsApp Connection
      </h2>
    </div>
    <div class="card-body">
      <div class="flex items-center gap-4 mb-6">
        <div class="status-indicator" style="width: 16px; height: 16px; border-radius: 50%; background-color: <%= whatsappStatus === 'CONNECTED' ? '#10b981' : (whatsappStatus === 'QR_READY' ? '#f59e0b' : '#ef4444') %>;"></div>
        <div>
          <h3 class="text-bold m-0">Status: <%= whatsappStatus %></h3>
          <% if (whatsappStatus === 'CONNECTED') { %>
            <p class="text-muted text-sm mt-1">The bot is connected and processing messages.</p>
          <% } else if (whatsappStatus === 'QR_READY') { %>
            <p class="text-muted text-sm mt-1">Scan the QR code below with WhatsApp to connect.</p>
          <% } else { %>
            <p class="text-muted text-sm mt-1">Bot is disconnected. Please check server logs.</p>
          <% } %>
        </div>
      </div>

      <% if (whatsappStatus === 'QR_READY' && qrDataUrl) { %>
        <div class="qr-container border rounded p-4 text-center bg-secondary">
          <img src="<%= qrDataUrl %>" alt="WhatsApp QR Code" class="mx-auto" style="max-width: 250px; background: white; padding: 10px; border-radius: 8px;">
          <p class="mt-4 text-sm text-muted">1. Open WhatsApp on your phone<br>2. Tap Menu <i data-lucide="more-vertical" class="inline w-4 h-4"></i> or Settings <i data-lucide="settings" class="inline w-4 h-4"></i> and select Linked Devices<br>3. Tap on Link a Device<br>4. Point your phone to this screen to capture the code</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- System Information -->
  <div class="card">
    <div class="card-header border-b">
      <h2 class="card-title flex items-center gap-2">
        <i data-lucide="server"></i> System Information
      </h2>
    </div>
    <div class="card-body">
      <dl class="details-list">
        <div class="detail-item">
          <dt>University Name</dt>
          <dd><%= university.name %></dd>
        </div>
        <div class="detail-item">
          <dt>Department</dt>
          <dd><%= university.department %> (<%= university.shortName %>)</dd>
        </div>
        <div class="detail-item">
          <dt>Environment</dt>
          <dd><%= process.env.NODE_ENV || 'development' %></dd>
        </div>
        <div class="detail-item">
          <dt>Google Sheets</dt>
          <dd>Connected <i data-lucide="check-circle" class="inline w-4 h-4 text-success"></i></dd>
        </div>
      </dl>
      <p class="text-sm text-muted mt-4">University details are configured in the .env file.</p>
    </div>
  </div>
</div>
