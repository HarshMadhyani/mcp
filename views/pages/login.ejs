<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — FOCA Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <style>
    body { background-color: var(--bg-secondary); display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: var(--spacing-4); }
    .login-card { width: 100%; max-width: 400px; }
    .login-header { text-align: center; margin-bottom: var(--spacing-6); }
    .login-brand { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: var(--black); color: var(--white); border-radius: 12px; margin-bottom: var(--spacing-4); }
    .login-title { font-size: 1.5rem; font-weight: 600; margin-bottom: var(--spacing-1); }
    .login-subtitle { color: var(--text-secondary); font-size: 0.875rem; }
  </style>
</head>
<body>
  <div class="card login-card">
    <div class="login-header">
      <div class="login-brand"><i data-lucide="graduation-cap"></i></div>
      <h1 class="login-title">Admin Login</h1>
      <p class="login-subtitle">FOCA Admission Support</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error" style="margin-bottom: var(--spacing-4);">
        <i data-lucide="alert-circle"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div class="form-group">
        <label for="email" class="form-label">Email</label>
        <input type="email" id="email" name="email" class="input" required autofocus placeholder="admin@marwadi.edu">
      </div>
      <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <input type="password" id="password" name="password" class="input" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Sign In</button>
    </form>
  </div>
  <script>lucide.createIcons();</script>
</body>
</html>
