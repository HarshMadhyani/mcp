<div class="page-header-content flex-between">
  <div>
    <h1 class="page-title">Frequently Asked Questions</h1>
    <p class="page-subtitle">Manage FAQs shown to students on WhatsApp</p>
  </div>
  <button class="btn btn-primary" onclick="openFaqModal()"><i data-lucide="plus"></i> Add FAQ</button>
</div>

<div class="card">
  <% if (faqs.length > 0) { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Question</th>
            <th>Category</th>
            <th>Status</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% faqs.forEach(faq => { %>
            <tr>
              <td>
                <div class="text-bold"><%= faq.question %></div>
                <div class="text-sm text-muted text-truncate mt-1" style="max-width: 400px;" title="<%= faq.answer %>"><%= faq.answer %></div>
              </td>
              <td><span class="badge badge-outline"><%= faq.category %></span></td>
              <td>
                <% if (faq.active === 'true') { %>
                  <span class="badge badge-primary">Active</span>
                <% } else { %>
                  <span class="badge badge-outline">Inactive</span>
                <% } %>
              </td>
              <td class="text-right">
                <button class="btn btn-sm btn-ghost" onclick="editFaq(this)"
                        data-id="<%= faq.faq_id %>"
                        data-q="<%= faq.question %>"
                        data-a="<%= faq.answer %>"
                        data-c="<%= faq.category %>"
                        data-active="<%= faq.active %>">
                  <i data-lucide="edit"></i>
                </button>
                <form action="/admin/faqs/<%= faq.faq_id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete this FAQ?')">
                  <button type="submit" class="btn btn-sm btn-ghost text-error"><i data-lucide="trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i data-lucide="help-circle"></i>
      <p>No FAQs found.</p>
    </div>
  <% } %>
</div>

<!-- FAQ Modal -->
<template id="faqModalTemplate">
  <form id="faqForm" method="POST" action="/admin/faqs">
    <div class="form-group">
      <label class="form-label">Question</label>
      <input type="text" name="question" id="faqQ" class="input w-full" required>
    </div>
    <div class="form-group">
      <label class="form-label">Answer</label>
      <textarea name="answer" id="faqA" class="textarea w-full" rows="4" required></textarea>
    </div>
    <div class="form-group">
      <label class="form-label">Category</label>
      <select name="category" id="faqC" class="select w-full">
        <option value="general">General</option>
        <option value="admission">Admission</option>
        <option value="documents">Documents</option>
        <option value="hostel">Hostel</option>
        <option value="placements">Placements</option>
      </select>
    </div>
    <div class="form-group flex items-center gap-2 mt-4">
      <input type="checkbox" name="active" id="faqActive" checked>
      <label for="faqActive" class="mb-0">Active</label>
    </div>
    <div class="form-footer mt-6 flex-end gap-2">
      <button type="button" class="btn btn-ghost" onclick="closeModal()">Cancel</button>
      <button type="submit" class="btn btn-primary">Save FAQ</button>
    </div>
  </form>
</template>

<script>
  function openFaqModal() {
    const tmpl = document.getElementById('faqModalTemplate').innerHTML;
    document.getElementById('modalTitle').innerText = 'Add FAQ';
    document.getElementById('modalBody').innerHTML = tmpl;
    document.getElementById('modalOverlay').style.display = 'flex';
  }

  function editFaq(btn) {
    const id = btn.dataset.id;
    openFaqModal();
    
    document.getElementById('modalTitle').innerText = 'Edit FAQ';
    document.getElementById('faqForm').action = `/admin/faqs/${id}`;
    
    document.getElementById('faqQ').value = btn.dataset.q;
    document.getElementById('faqA').value = btn.dataset.a;
    document.getElementById('faqC').value = btn.dataset.c;
    document.getElementById('faqActive').checked = btn.dataset.active === 'true';
  }

  document.getElementById('modalClose').addEventListener('click', closeModal);
  function closeModal() {
    document.getElementById('modalOverlay').style.display = 'none';
  }
</script>
